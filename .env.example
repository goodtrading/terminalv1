# Copia a .env y rellena. No subas .env al repositorio.

# Neon (u otro Postgres): Dashboard → Connection string → URI
DATABASE_URL=

JWT_SECRET=change_me_min_16_chars______

SAAS_ADMIN_EMAIL=
SAAS_ADMIN_PASSWORD=

# --- Broker connection (BingX) — login only, NO API keys ---
BINGX_REFERRAL_URL=https://bingx.com/es/partner/Goodtradingacademy
BINGX_ENABLE_BROKER_LOGIN=false
BINGX_BROKER_LOGIN_URL=
BINGX_BROKER_CALLBACK_URL=http://localhost:5000/api/broker/bingx/callback
BINGX_ENABLE_BROKER_LOGIN_DEMO=false

# --- BingX secure API ---
BINGX_ENABLE_API_CONNECTION=true
BINGX_API_BASE_URL=https://open-api.bingx.com
BINGX_DEFAULT_SYMBOL=BTC-USDT
# Global server secret (NOT per user). Required to persist each user's BingX API Key/Secret (AES-256-GCM).
BINGX_CREDENTIAL_ENCRYPTION_KEY=

# =============================================================================
# Phase 5B — dry-run preview (default safe: live OFF)
# =============================================================================
BINGX_ENABLE_DRY_RUN=true
BINGX_ENABLE_API_TRADING=true
BINGX_ENABLE_LIVE_TRADING=false
BINGX_ENABLE_ORDER_SUBMIT=false
BINGX_ENABLE_ORDER_CANCEL=false
BINGX_ENABLE_POSITION_CLOSE=false

# =============================================================================
# Phase 5C — controlled live LIMIT submit (enable ONLY after blocker tests)
# Uncomment and restart server — do NOT enable until manual checks pass.
# =============================================================================
# BINGX_ENABLE_DRY_RUN=true
#
# # Live controlled limit submit
# BINGX_ENABLE_LIVE_TRADING=true
# BINGX_ENABLE_API_TRADING=true
# BINGX_ENABLE_ORDER_SUBMIT=true
#
# # Still disabled in 5C
# BINGX_ALLOW_MARKET_ORDERS=false
# BINGX_ENABLE_ORDER_CANCEL=false
# BINGX_ENABLE_POSITION_CLOSE=false
# LIVE_TRADING_KILL_SWITCH=false
#
# # Strict limits (first real test: 2 USDT)
# MAX_ORDER_NOTIONAL_USDT=2
# MAX_ACCOUNT_RISK_PCT=0.5
# REQUIRE_SL_ON_LIVE_ORDERS=true
#
# BINGX_ESTIMATED_FEE_BPS=5
# BINGX_ESTIMATED_SLIPPAGE_BPS=2

# --- Execution risk guard (dry-run defaults; override when 5C active) ---
MAX_ORDER_NOTIONAL_USDT=25
MAX_ACCOUNT_RISK_PCT=1
MAX_LEVERAGE=5
REQUIRE_ORDER_CONFIRMATION=true
REQUIRE_SL_ON_LIVE_ORDERS=true
ALLOW_MARKET_ORDERS=false
BINGX_ALLOW_MARKET_ORDERS=false
LIVE_TRADING_KILL_SWITCH=false
BINGX_ESTIMATED_FEE_BPS=5
BINGX_ESTIMATED_SLIPPAGE_BPS=2
