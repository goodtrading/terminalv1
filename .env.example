# Copia a .env y rellena. No subas .env al repositorio.



# Neon (u otro Postgres): Dashboard → Connection string → URI

DATABASE_URL=



# --- Email (verification + password reset) ---
# Required in Railway production for real emails. Local dev without config logs [email:dev] to console.

# Railway (recommended — HTTPS API; outbound SMTP is blocked on many hosts):
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=<Resend API key>
#   EMAIL_FROM=GoodTrading <noreply@goodtrading.online>
#   APP_PUBLIC_URL=https://goodtrading.up.railway.app

# Provider: resend | smtp (default smtp if unset)
EMAIL_PROVIDER=resend

RESEND_API_KEY=

# Gmail example (EMAIL_PROVIDER=smtp):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=GoodTradingpay@gmail.com
#   SMTP_PASS=<Google App Password — not your login password>
#   EMAIL_FROM=GoodTrading <GoodTradingpay@gmail.com>

# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=<SendGrid API key>

SMTP_HOST=

SMTP_PORT=587

SMTP_USER=

SMTP_PASS=

EMAIL_FROM=GoodTrading <GoodTradingpay@gmail.com>

# Public URL for password-reset links (desktop local dev; use production URL when deployed)
APP_PUBLIC_URL=http://localhost:5000

AUTH_VERIFICATION_TTL_MINUTES=15

AUTH_RESET_TTL_MINUTES=30

# Optional: protect POST /api/dev/test-email in local dev
# DEV_EMAIL_TEST_SECRET=

# Optional: default recipient for npm run test:email
# TEST_EMAIL_TO=



JWT_SECRET=change_me_min_16_chars______



SAAS_ADMIN_EMAIL=

SAAS_ADMIN_PASSWORD=



# --- Broker connection (BingX) — login only, NO API keys ---

BINGX_REFERRAL_URL=https://bingx.com/es/partner/Goodtradingacademy

BINGX_ENABLE_BROKER_LOGIN=false

BINGX_BROKER_LOGIN_URL=

BINGX_BROKER_CALLBACK_URL=http://localhost:5000/api/broker/bingx/callback

BINGX_ENABLE_BROKER_LOGIN_DEMO=false



# --- BingX secure API ---

BINGX_ENABLE_API_CONNECTION=true

BINGX_API_BASE_URL=https://open-api.bingx.com

BINGX_DEFAULT_SYMBOL=BTC-USDT

# Global server secret (NOT per user). Required to persist each user's BingX API Key/Secret (AES-256-GCM).

BINGX_CREDENTIAL_ENCRYPTION_KEY=



# =============================================================================

# Phase 5B — dry-run preview (default safe: live OFF)

# =============================================================================

BINGX_ENABLE_DRY_RUN=true

BINGX_ENABLE_API_TRADING=true

BINGX_ENABLE_LIVE_TRADING=false

BINGX_ENABLE_ORDER_SUBMIT=false

BINGX_ENABLE_ORDER_CANCEL=false

BINGX_ENABLE_POSITION_CLOSE=false

# Phase B1 — server-side write freeze (default ON). Set to false only when live phase is approved.
BINGX_READ_ONLY_FREEZE=true

# AI-8.0 / BINGX-1 — account trading activity read model (defaults OFF / safe)
BINGX_READ_ONLY_MODE=true
GOODTRADING_BINGX_ACCOUNT_ENABLED=false
GOODTRADING_BINGX_ACCOUNT_AUTO_REFRESH=false
# GOODTRADING_BINGX_ACCOUNT_POLL_MS=15000
# BINGX_RECV_WINDOW_MS=5000
# BINGX_ACCOUNT_REQUEST_TIMEOUT_MS=12000
# AI-8.1 / AI-8.1.1 Decision Context Recorder (defaults OFF / safe)
GOODTRADING_DECISION_CONTEXT_RECORDER_ENABLED=false
GOODTRADING_DECISION_CONTEXT_REPOSITORY=postgres
# Local/test may set GOODTRADING_DECISION_CONTEXT_REPOSITORY=memory explicitly.
# Production + recorder=true + memory is refused (UNSAFE_NON_DURABLE_DECISION_CONTEXT_STORE).

# Optional comma-separated plan slugs excluded from BingX monitoring entitlement.
# BINGX_EXCLUDED_PLAN_SLUGS=free,trial



# =============================================================================

# Phase 5C — controlled live LIMIT submit (enable ONLY after blocker tests)

# Uncomment and restart server — do NOT enable until manual checks pass.

# =============================================================================

# BINGX_ENABLE_DRY_RUN=true

#

# # Live controlled limit submit

# BINGX_ENABLE_LIVE_TRADING=true

# BINGX_ENABLE_API_TRADING=true

# BINGX_ENABLE_ORDER_SUBMIT=true

#

# # Still disabled in 5C

# BINGX_ALLOW_MARKET_ORDERS=false

# BINGX_ENABLE_ORDER_CANCEL=false

# BINGX_ENABLE_POSITION_CLOSE=false

# LIVE_TRADING_KILL_SWITCH=false

#

# # Strict limits (first real test: 2 USDT)

# MAX_ORDER_NOTIONAL_USDT=2

# MAX_ACCOUNT_RISK_PCT=0.5

# REQUIRE_SL_ON_LIVE_ORDERS=true

#

# BINGX_ESTIMATED_FEE_BPS=5

# BINGX_ESTIMATED_SLIPPAGE_BPS=2



# --- Execution risk guard (dry-run defaults; override when 5C active) ---

MAX_ORDER_NOTIONAL_USDT=25

MAX_ACCOUNT_RISK_PCT=1

MAX_LEVERAGE=5

REQUIRE_ORDER_CONFIRMATION=true

REQUIRE_SL_ON_LIVE_ORDERS=true

ALLOW_MARKET_ORDERS=false

BINGX_ALLOW_MARKET_ORDERS=false

LIVE_TRADING_KILL_SWITCH=false

BINGX_ESTIMATED_FEE_BPS=5

BINGX_ESTIMATED_SLIPPAGE_BPS=2



# --- Unified alerts ---

ALERTS_ENABLED=true

ALERTS_DESKTOP_NATIVE_ENABLED=true

ALERTS_FLOW_ENABLED=false

ALERTS_WEB_NOTIFICATIONS_ENABLED=false

ALERTS_MOBILE_PUSH_ENABLED=false

ALERTS_ALLOW_MEMORY_FALLBACK=true

