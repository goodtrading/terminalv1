  "scripts": {
    "generate:gex": "node scripts/deribit-gex.js || true",
    "dev:client": "vite dev --port 5000",
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "dev:clean": "node -e \"const fs=require('fs');const os=require('os');const p=require('path');const t=p.join(os.tmpdir(),'goodtrading-vite-cache');try{fs.rmSync(t,{recursive:true,force:true});}catch(e){}try{fs.rmSync('node_modules/.vite',{recursive:true,force:true});}catch(e){}console.log('Vite cache cleared');\"",
    "build": "npm run generate:gex && tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "test:live-submit-blockers": "tsx --test server/services/execution/liveOrderSubmit.blockers.test.ts",
    "test:bingx-normalize": "tsx --test server/services/exchanges/bingx/bingxNormalize.test.ts",
    "test:bingx-freeze": "tsx --test server/services/exchanges/bingx/bingxReadOnlyFreeze.test.ts",
    "test:bingx-access": "tsx --test server/services/exchanges/bingx/bingxAccessService.test.ts",
    "test:bingx-rate-limit": "tsx --test server/middleware/bingxRateLimit.test.ts",
    "test:bingx-b1": "tsx --test server/services/exchanges/bingx/bingxNormalize.test.ts server/services/exchanges/bingx/bingxReadOnlyFreeze.test.ts server/services/exchanges/bingx/bingxReadOnlyFreeze.submit.test.ts server/services/exchanges/bingx/bingxAccessService.test.ts server/services/exchanges/bingx/bingxOwnership.test.ts server/services/exchanges/bingx/bingxOwnership.integration.test.ts server/services/exchanges/bingx/bingxReadOnlyService.structure.test.ts server/services/exchanges/bingx/bingxReadOnlyCache.test.ts server/services/exchanges/bingx/bingxRateLimit.e2e.test.ts server/middleware/bingxRateLimit.test.ts server/services/execution/liveOrderSubmit.blockers.test.ts",
    "test:bingx-ownership": "tsx --test server/services/exchanges/bingx/bingxOwnership.test.ts",
    "test:bingx-freeze-submit": "tsx --test server/services/exchanges/bingx/bingxReadOnlyFreeze.submit.test.ts",
    "test:bingx-snapshot": "tsx --test server/services/exchanges/bingx/bingxReadOnlyService.structure.test.ts",
    "test:bingx-cache": "tsx --test server/services/exchanges/bingx/bingxReadOnlyCache.test.ts",
    "test:bingx-ownership-integration": "tsx --test server/services/exchanges/bingx/bingxOwnership.integration.test.ts",
    "test:bingx-rate-limit-e2e": "tsx --test server/services/exchanges/bingx/bingxRateLimit.e2e.test.ts",
    "test:mobile-v2": "tsx --test --test-force-exit server/mobile/v2/__tests__/mobileMarketStateV2.test.ts server/mobile/v2/__tests__/mobileMarketStateV2.routes.test.ts server/mobile/v2/__tests__/legacyMobileContract.test.ts server/services/mobile/mobileTerminalAccessService.test.ts",
    "test:goodtrading-ai": "tsx --test --test-force-exit shared/goodTradingAi.test.ts server/ai/goodTradingAi/mentorKnowledge.test.ts server/ai/goodTradingAi/mockProvider.test.ts server/ai/goodTradingAi/service.test.ts server/ai/goodTradingAi/mentorResponseEngine.test.ts server/ai/goodTradingAi/responseValidator.test.ts server/ai/goodTradingAi/knowledge/registry.test.ts server/ai/goodTradingAi/knowledge/retrieve.test.ts server/ai/goodTradingAi/openaiConfig.test.ts server/ai/goodTradingAi/openai/mentorPrompt.test.ts server/ai/goodTradingAi/openaiProvider.test.ts server/ai/goodTradingAi/reasoning/reasoning.test.ts server/routes/aiChat.routes.test.ts server/routes/aiProviderStatus.routes.test.ts client/src/components/terminal/__tests__/AIChatPanel.mentor.test.tsx",
    "test:goodtrading-ai:evals": "tsx --test --test-force-exit server/ai/goodTradingAi/evals/mentorEval.test.ts server/ai/goodTradingAi/evals/openaiInjectionEval.test.ts",
    "goodtrading-ai:calibration:test": "tsx --test --test-force-exit server/ai/goodTradingAi/calibration/calibration.test.ts server/routes/calibration.routes.test.ts",
    "goodtrading-ai:calibration:apply": "tsx scripts/goodtrading-ai-calibration-apply.ts",
    "goodtrading-ai:calibrate": "tsx scripts/goodtrading-ai-calibrate.ts",
    "goodtrading-ai:openai:smoke": "tsx scripts/goodtrading-ai-openai-smoke.ts",
    "db:push": "drizzle-kit push",
    "db:push:saas": "tsx scripts/apply-saas-tables.ts",
    "test:email": "tsx scripts/test-email.ts",
    "db:fix:saas-fk-users": "tsx scripts/repoint-saas-fks-to-users.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "dev:agent": "tsx script/run-dev-agent.ts",
    "task:agent": "tsx script/run-task-agent.ts",
    "tauri": "tauri",
    "dev:desktop": "cross-env VITE_PLATFORM=desktop VITE_HEATMAP_ENABLED=true npm run tauri dev",
    "build:desktop:web": "cross-env VITE_PLATFORM=desktop VITE_HEATMAP_ENABLED=true VITE_API_BASE_URL=https://goodtrading.up.railway.app npm run build",
    "build:desktop": "cross-env VITE_PLATFORM=desktop VITE_HEATMAP_ENABLED=true npm run tauri build",
    "prepare:desktop-release": "node scripts/prepare-desktop-release.mjs",
    "print:desktop-release-command": "node scripts/print-github-release-command.mjs",
    "doctor:desktop": "node scripts/doctor-desktop-release.mjs",
    "release:desktop": "npm run build:desktop && node scripts/prepare-desktop-release.mjs"
  },
